# =============================================================
# HHDcoin - Environment Configuration Template
# Copy file này thành .env và điền giá trị thực.
# Mọi biến được validate bởi server/config/env.ts (fail-fast lúc boot).
# =============================================================

# DATABASE — https://neon.tech (miễn phí 0.5GB)
# Bỏ trống ở dev → tự dùng PGlite in-memory (không cần cài DB)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/hhdcoin?sslmode=require

# JWT — sinh ngẫu nhiên ≥16 ký tự, BẮT BUỘC khi NODE_ENV=production
JWT_SECRET=your-random-64-char-secret-here

# CORS — origin được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS=https://hhdcoin.net,https://www.hhdcoin.net

# =============================== AI ===========================
# Router thử lần lượt theo thứ tự; nhà cung cấp nào lỗi/hết credit sẽ tự chuyển tiếp.
AI_PROVIDER_ORDER=gemini,claude,openai

# Gemini — AI CHÍNH, free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Anthropic Claude (tùy chọn) — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001

# OpenAI (tùy chọn) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# ============================ THANH TOÁN ======================
# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# ============================== EMAIL =========================
# Ưu tiên Resend (HTTP API — hoạt động cả khi host chặn cổng SMTP)
RESEND_API_KEY=
RESEND_FROM=
# SMTP dự phòng (chỉ dùng khi host cho phép cổng 587/465)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=HHDcoin <noreply@hhdcoin.net>

# URL công khai của app (dùng trong link email)
APP_URL=https://hhdcoin.net

# Mobile / frontend tĩnh: URL API backend (để trống khi chạy full-stack cùng origin)
VITE_API_BASE_URL=

# ============================ HỌC THUẬT =======================
# Hồ sơ khoa học hiển thị ở trang /research
ORCID_ID=0000-0001-5811-7154

# ======================= BACKUP (tùy chọn) ====================
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
BACKUP_SCHEDULER_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_KEEP_COUNT=7

# ============================== SERVER ========================
NODE_ENV=production
PORT=5000
