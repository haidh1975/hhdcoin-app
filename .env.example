# ============================================================
# HHD-I — biến môi trường (bản đầy đủ cho toàn monorepo)
# Web (apps/web) đọc từ apps/web/.env — xem apps/web/.env.example
# ============================================================

# --- Server (apps/web) ---

# Database — SQLite mặc định, đổi sang Postgres khi production
DATABASE_URL="file:./dev.db"

# NextAuth
# bắt buộc: chuỗi ngẫu nhiên >= 32 ký tự (openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Anthropic API key cho các tính năng AI (tùy chọn — không có key sẽ dùng mock)
ANTHROPIC_API_KEY=

# --- Web3 (apps/web, tùy chọn) ---

# WalletConnect project ID — kết nối ví
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Địa chỉ contract HHD trên BSC (để trống cho tới khi token được triển khai)
NEXT_PUBLIC_HHD_TOKEN_ADDRESS=

# --- Mobile (apps/mobile) ---

# URL của API web mà app mobile gọi tới (mặc định http://localhost:3000)
EXPO_PUBLIC_API_URL=http://localhost:3000
