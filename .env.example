# Anthropic API key cho cac tinh nang AI (tuy chon — khong co key se dung mock)
ANTHROPIC_API_KEY=your_api_key_here

# Database (apps/web/.env) — SQLite mac dinh, doi sang Postgres khi production
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET=change-me-to-a-random-string
NEXTAUTH_URL=http://localhost:3000
