# HHDcoin Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/hhdcoin

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-here

# OpenAI Integration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Stripe Payment Integration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
VITE_STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key

# Mobile API Configuration (for Capacitor builds)
# Set this to your deployed backend URL for mobile apps
# Examples:
# - Development: http://localhost:5000
# - Production: https://api.hhdcoin.com
# - Replit deployment: https://your-repl-name.replit.app
VITE_API_BASE_URL=

# Google Drive Backup (Optional)
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=your-google-private-key
GOOGLE_DRIVE_FOLDER_ID=your-folder-id

# Backup Scheduler (Optional)
BACKUP_SCHEDULER_ENABLED=false