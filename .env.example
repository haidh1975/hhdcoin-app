# =============================================================
# HHDcoin - Environment Configuration Template
# Copy file này thành .env và điền giá trị thực
# =============================================================

# DATABASE — https://neon.tech (miễn phí)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/hhdcoin?sslmode=require

# JWT — sinh ngẫu nhiên, giữ bí mật
JWT_SECRET=your-random-64-char-secret-here

# OpenAI — https://platform.openai.com/api-keys (tùy chọn)
OPENAI_API_KEY=sk-...

# Stripe — https://dashboard.stripe.com/test/apikeys (tùy chọn)
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# Email SMTP (tùy chọn — Gmail / Brevo / Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=HHDcoin <no-reply@hhdcoin.com>

# URL công khai của app (dùng trong link email)
APP_URL=https://your-app.up.railway.app

# Mobile API URL (để trống khi dùng web)
VITE_API_BASE_URL=

# Google Drive Backup (tùy chọn)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
BACKUP_SCHEDULER_ENABLED=false

# Server
NODE_ENV=production
PORT=5000
