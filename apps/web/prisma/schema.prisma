// HHD-I Prisma schema
// Để chuyển sang PostgreSQL: đổi provider thành "postgresql" và DATABASE_URL
// thành chuỗi kết nối Postgres (vd: postgresql://user:pass@host:5432/hhdi).
// Schema không dùng tính năng riêng của SQLite nên không cần sửa model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AssetType {
  CRYPTO
  STOCK
}

enum TransactionType {
  BUY
  SELL
  DEPOSIT
  WITHDRAW
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DCAFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum StakeTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum StakeStatus {
  ACTIVE
  UNSTAKED
}

enum ProposalStatus {
  ACTIVE
  PASSED
  REJECTED
  EXECUTED
}

enum SaleRoundStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         Role          @default(USER)
  status       UserStatus    @default(ACTIVE)
  createdAt    DateTime      @default(now())
  holdings      Holding[]
  transactions  Transaction[]
  dcaSchedules  DCASchedule[]
  alerts        Alert[]
  stakes        Stake[]
  votes         Vote[]
  proposals     Proposal[]
  salePurchases SalePurchase[]
}

model Asset {
  id           String        @id @default(cuid())
  symbol       String        @unique
  name         String
  type         AssetType
  enabled      Boolean       @default(true)
  holdings     Holding[]
  transactions Transaction[]
  dcaSchedules DCASchedule[]
}

model Holding {
  id          String @id @default(cuid())
  userId      String
  assetId     String
  amount      Float
  avgBuyPrice Float
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset       Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([userId, assetId])
}

model Transaction {
  id         String            @id @default(cuid())
  userId     String
  assetId    String?
  type       TransactionType
  amount     Float
  price      Float
  totalValue Float
  status     TransactionStatus @default(COMPLETED)
  createdAt  DateTime          @default(now())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset      Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model DCASchedule {
  id        String       @id @default(cuid())
  userId    String
  assetId   String
  amountUsd Float
  frequency DCAFrequency
  nextRun   DateTime
  active    Boolean      @default(true)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset     Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Alert {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  severity  String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Stake {
  id            String      @id @default(cuid())
  userId        String
  tier          StakeTier
  amount        Float
  apy           Float
  lockDays      Int
  startAt       DateTime    @default(now())
  unlockAt      DateTime
  autoCompound  Boolean     @default(false)
  status        StakeStatus @default(ACTIVE)
  rewardClaimed Float       @default(0)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Proposal {
  id          String         @id @default(cuid())
  title       String
  description String
  status      ProposalStatus @default(ACTIVE)
  votesFor    Float          @default(0)
  votesAgainst Float         @default(0)
  createdAt   DateTime       @default(now())
  endsAt      DateTime
  creatorId   String
  creator     User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  votes       Vote[]
}

model Vote {
  id         String   @id @default(cuid())
  proposalId String
  userId     String
  support    Boolean
  weight     Float
  createdAt  DateTime @default(now())
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([proposalId, userId])
}

model SaleRound {
  id           String          @id @default(cuid())
  name         String
  priceUsd     Float
  allocation   Float
  hardCapUsd   Float
  raisedUsd    Float           @default(0)
  tgeUnlockPct Float
  vestingNote  String
  status       SaleRoundStatus
  order        Int
  purchases    SalePurchase[]
}

model SalePurchase {
  id        String    @id @default(cuid())
  userId    String
  roundId   String
  amountUsd Float
  tokens    Float
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  round     SaleRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([userId])
}
